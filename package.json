{
  "name": "our-pixel-home",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A cozy pixel studio apartment for long-distance couples.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:catalog-sql": "node --experimental-strip-types scripts/gen-catalog-sql.ts",
    "gen:icons": "node --experimental-strip-types scripts/gen-icons.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/dotgothic16": "5.3.1",
    "@fontsource/jersey-10": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@fontsource/tiny5": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "@preact/signals": "1.3.4",
    "@supabase/supabase-js": "2.118.0",
    "preact": "10.29.8",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "@types/three": "0.170.0",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7"
  }
}
