{
  "name": "our-pixel-home",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A cozy pixel studio apartment for long-distance couples.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:icons": "node --experimental-strip-types scripts/gen-icons.ts",
    "build:api": "esbuild server/handler.ts --bundle --format=esm --platform=neutral --target=es2022 --legal-comments=none --banner:js='// Generated by npm run build:api from server/handler.ts. Do not edit.' --outfile=supabase/functions/api/handler.js",
    "test:db": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres@127.0.0.1:5432/postgres} vitest run tests/server.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/dotgothic16": "5.3.1",
    "@fontsource/jersey-10": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@fontsource/tiny5": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "@preact/signals": "1.3.4",
    "@supabase/supabase-js": "2.118.0",
    "preact": "10.29.8",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "@types/three": "0.170.0",
    "esbuild": "0.27.0",
    "postgres": "3.4.5",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.7"
  }
}
